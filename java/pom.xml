<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.cj-chen</groupId>
  <artifactId>trimal-java</artifactId>
  <!-- The number of the trimAl release this port reproduces. -->
  <version>1.5.1</version>
  <packaging>jar</packaging>

  <name>trimal-java</name>
  <description>Java 11 port of trimAl 1.5.1, with differential tests against the reference C++ implementation</description>
  <url>https://github.com/AI4S-YB/trimAl-java</url>

  <scm>
    <url>https://github.com/AI4S-YB/trimAl-java</url>
    <connection>scm:git:https://github.com/AI4S-YB/trimAl-java.git</connection>
    <developerConnection>scm:git:git@github.com:AI4S-YB/trimAl-java.git</developerConnection>
  </scm>

  <licenses>
    <license>
      <name>GNU General Public License, Version 3</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
      <distribution>repo</distribution>
      <comments>Derivative work of trimAl (inab, GPL-3.0); see the LICENSE file</comments>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <!-- Fixed timestamp: two builds of one commit produce the same JAR bytes, so a
         verification record can name the exact JAR by SHA-256. The date is the build
         date the reference trimAl v1.5.rev1 reports on the command line. -->
    <project.build.outputTimestamp>2025-11-25T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>trimal</finalName>
    <resources>
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE.md</include>
          <include>licenses/**</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <!-- Pinned so that two builds, on whatever Maven runs them, use the same plugins. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>11</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>trimal.TrimAl</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- GoldenCliTest runs the command lines on repository-relative paths: its
               working directory is the recorded copy of the input files. -->
          <workingDirectory>${project.build.testOutputDirectory}/golden/root</workingDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
