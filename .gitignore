# Build output
**/target/
**/__pycache__/
*.class
*.jar
*.o

# Reference source/data snapshot, the reference build and downloaded archives.
# Anchored: the golden test resources hold a committed copy of some dataset files
# under java/src/test/resources/golden/root/upstream/.
/upstream/
*.seed.gz
*.tar.gz
verify/bin/
verify/downloads/

# Generated corpora: reproducible from the extractors, never committed
verify/baseline/
verify/corpus/argfuzz*/
verify/corpus/eggnog/
verify/corpus/extended/
verify/corpus/fuzz*/
verify/corpus/generated/
verify/corpus/pfam/
verify/corpus/pffull/

# Verification scratch and per-run output (the tracked summary is
# verify/validation-summary.json)
verify/**/results/
verify/**/work/
verify/*.log
verify/results/
verify/integration/
verify/probe/
verify/threading/
verify/windows-matrix/
verify/windows-main/*/
verify/windows-main/*.json
verify/companions/classes/
verify/companions/companions.jar
verify/companions/compile.*
verify/companions/inputs/
verify/companions/outputs/
verify/companions/runs/
verify/companions/result*.json
verify/companions/windows_outputs/
verify/companions/*.log
verify/alignment_audit/audit_probe_cpp
verify/alignment_audit/classes*/
verify/alignment_audit/corpus/
verify/alignment_audit/probes*/
verify/alignment_audit/results*/
verify/numeric/*.log
verify/numeric/*.txt
verify/numeric/*.json
verify/numeric/after.json
verify/numeric/before.json
verify/numeric/cases.txt
verify/numeric/classes/
verify/numeric/matrices/
